flowchart TB

    %% DataGoblin — architecture as executed
    %% Every node below is a real module. Nothing is aspirational: if a box is here,
    %% the file exists and the pipeline calls it. Where a stage cannot honestly claim
    %% to have run, that is written on the node.
    %%
    %% Read the evidence track (right) as the point of the whole system. Extraction
    %% is not the product; extraction *plus a retrievable quote* is.

    subgraph CLIENT["Browser — React SPA, port 4173"]
        direction LR
        UI["Shell / NavRail / CommandPalette<br/>dataset · records · evidence rail"]
        HOOK["useResource<br/>abort on unmount, stale-while-revalidate"]
        UI --- HOOK
    end

    subgraph API["FastAPI — app.main, port 8000"]
        direction TB
        AUTH["require_api_key<br/>correlation_id on every response"]
        SSE["/api/runs/:id/events<br/>SSE stage + record stream"]
        ROUTES["REST surface<br/>datasets · records · coverage · gaps<br/>backfill · refresh · rejudge · export"]
        AUTH --> ROUTES
        AUTH --> SSE
    end

    subgraph PIPELINE["Pipeline — services/runner.py, one asyncio task per run"]
        direction TB

        subgraph S1["1 · PLANNING"]
            PLANNER["planner.py<br/>query → schema, fields, dedupe_keys<br/>traversal caps, credit budget"]
            PLANSTORE[("workflows<br/>compiled plan, upserted on id")]
            PLANNER --> PLANSTORE
        end

        subgraph S2["2 · DISCOVERING"]
            DISC["discovery.py<br/>Tavily, ≤5 queries · ≤5 results<br/>candidates SCORED against plan<br/>before the cap applies"]
            ROUTER["source_router.py<br/>blocklist · domain allow"]
            DISC --- ROUTER
        end

        subgraph S3["3 · FETCHING"]
            CRAWL["crawler.py<br/>breadth-first, same-host<br/>≤12 pages · depth ≤2 · ≤10/domain"]
            REUSE["reuse hook<br/>URL fingerprint hit → stored page<br/>emits source.reused, never refetched"]
            POLITE["politeness.py<br/>per-host delay, robots, backoff"]
            FETCHER["fetcher waterfall<br/>crawl4ai → impersonate → jina → http"]
            CRAWL --- REUSE
            CRAWL --- POLITE
            POLITE --- FETCHER
        end

        subgraph S4["4 · REDUCING"]
            REDUCE["reducer.py<br/>page_evidence_text_parts<br/>CLEAN MARKDOWN FIRST, then DOM<br/>store + extractor call the SAME fn"]
        end

        subgraph S5["5 · EXTRACTING"]
            EXTRACT["extractor.py<br/>one structured call per page<br/>24,000-char window<br/>logs clean_truncated / dom_truncated"]
            LLMOPEN["llm/opencode.py<br/>local OpenCode server :4096<br/>fallback cascade → zen → groq → gemini"]
            EXTRACT -.-> LLMOPEN
        end

        subgraph S6["6 · VALIDATING — where truth is decided"]
            QUOTE["QUOTE GATE<br/>no quote → keep value, unverified<br/>quote not on page → discard<br/>fail OPEN when page has no References"]
            DET["jev.deterministic_verdict<br/>FREE, before any budget charge<br/>quote absent → NOT_SUPPORTED<br/>value inside quote → SUPPORTED"]
            JUDGE["jev.evidence_verification<br/>noul: does this evidence support the claim?<br/>0.4–0.6 → UNCERTAIN, never 'verified'"]
            BUDGET["JudgeBudget(400/run)<br/>exhausted → judgment_unavailable<br/>the value is KEPT"]
            QUOTE --> DET --> BUDGET --> JUDGE
        end

        subgraph S7["7 · NORMALIZE"]
            NORM["normalizer.py<br/>name-driven: date · url · phone · currency<br/>absence markers dropped, 0 and False kept"]
        end

        subgraph S8["8 · DEDUPLICATING"]
            DEDUP["deduper.py<br/>L1 exact-normalised → L2 RapidFuzz token_set<br/>merge UNIONS provenance, never overwrites"]
        end

        subgraph S9["9 · FINALIZING"]
            FIN["provenance.summarize<br/>→ counts + a COPY into datasets"]
        end

        PLANNER --> DISC --> CRAWL --> REDUCE --> EXTRACT --> QUOTE --> NORM --> DEDUP --> FIN
    end

    subgraph STORE["Persistence — Postgres on Supabase, pooler ap-south-1"]
        direction LR
        PAGES[("pages<br/>markdown = evidence text<br/>UNIQUE (run_id, url)")]
        RECS[("dataset_records<br/>row_json holds value + quote + status")]
        META[("runs · run_events<br/>sources · exports")]
        GAPS[("dataset_gaps<br/>007: which phase a missing field reached")]
    end

    subgraph REPAIR["Gap closing — cost-aware, evidence-preserving"]
        direction TB
        COV["coverage.py<br/>per-field fill + verdict counts"]
        GAPCAT["gaps.py<br/>schema_gap · depth_gap · evidence_gap"]
        P1["PHASE 1 — backfill.py<br/>re-read STORED pages<br/>no external requests, fills empty cells only"]
        P2["PHASE 2 — gapfill.py<br/>search the record's OWN identity<br/>evidence_gap REFUSED: fetch cannot add a verdict"]
        RJ["rejudge.py<br/>733 of 992 settled FREE<br/>259 judge calls · verdict only, value never touched"]
        COV --> GAPCAT --> P1 --> P2
        COV --> RJ
    end

    subgraph AGG["Aggregates — one round trip per page, not per dataset"]
        direction TB
        DASH["dashboard.py<br/>coverage_aggregates in SQL via jsonb_each<br/>single-flight: a cold stampede costs ONE compute<br/>300s TTL, dropped on every write"]
        PROF["profile.py + sector.py<br/>domain reading with a receipt<br/>3 tiers: attested · supported · unattested"]
    end

    HOOK -->|"REST + AbortSignal"| AUTH
    SSE -.->|"live stage + record events"| HOOK

    FETCHER --> PAGES
    PAGES --> REDUCE
    JUDGE --> RECS
    FIN --> RECS
    FIN --> META
    RECS --> COV
    RECS --> DASH
    RECS --> PROF
    GAPCAT --> GAPS
    P1 --> RECS
    P2 --> RECS
    RJ --> RECS
    DASH --> ROUTES
    PROF --> ROUTES

    classDef evidence fill:#e8f5ec,stroke:#2f7d4f,stroke-width:2px,color:#12331f
    classDef refuse fill:#fdecea,stroke:#b3372a,stroke-width:2px,color:#4a1410
    classDef store fill:#eef2f8,stroke:#3c5a86,color:#16233a
    classDef cost fill:#fdf3e2,stroke:#9a6b1f,color:#3d2a08

    class QUOTE,DET,JUDGE,REDUCE evidence
    class P2,BUDGET refuse
    class PAGES,RECS,META,GAPS store
    class DASH,RJ,P1 cost