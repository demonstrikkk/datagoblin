# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Start the API from the REPO ROOT so this file is found:
#   set PYTHONPATH=backend && python -m uvicorn app.main:app --port 8000

# --- persistence ---
# PERSISTENCE=postgres  -> the app reads DATABASE_URL and writes real tables
# PERSISTENCE=local     -> JSONL dev store, for tests / no infrastructure
# The adapter in use is reported by GET /api/health, so a drift is visible.
PERSISTENCE=postgres
# Apply schema with:  python backend/scripts/db_migrate.py
DATABASE_URL=
# Only needed by the REST client; the app itself uses DATABASE_URL.
SUPABASE_URL=
SUPABASE_KEY=

# --- discovery ---
TAVILY_API_KEY=

# --- LLM chain: opencode (primary) -> groq -> gemini (fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- opencode primary generator (local server) ---
# Start it with:  OPENCODE_SERVER_PASSWORD=<same value> opencode serve --port 4096
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
OPENCODE_TIMEOUT_S=240
# Pinned reader. The v1 message protocol sends the model per request, so this is
# now actually honoured (it was silently ignored before). A bare model id is
# preferred; the `opencode/<id>` form is accepted and split for you.
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# Provider id sent alongside the model id.
OPENCODE_PROVIDER_ID=opencode
# Strict reader mode: opencode is THE reader, cloud fallbacks never fire.
OPENCODE_STRICT=false

# --- OpenCode Zen gateway (one key, the whole model gateway) ---
# Get the key from `opencode auth login` (stored under provider "opencode").
# Only space-bunny-free answers on direct REST; the other free models return
# 403 FreeTierError and are reached through the OpenCode server above.
ZEN_ENABLED=true
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=space-bunny-free
ZEN_TIMEOUT_S=120
ZEN_MAX_RETRIES=2
ZEN_MAX_TOKENS=4000
# Fan-out for /api/intel/ask. Empty = all 10 free text models.
ZEN_FANOUT_CONCURRENCY=4
ZEN_FANOUT_MODELS=
# Free typed-decision judge, tried before the paid OpenRouter one.
ZEN_JEV_ENABLED=true
JEV_ZEN_MODEL=jev-1.13-free

# --- judge (Jev via OpenRouter, paid fallback) ---
TYPESAFE_API_KEY=

# --- optional fallbacks ---
JINA_API_KEY=
FEATURE_JINA=false

# --- budgets / caps (0 = unlimited where noted) ---
RUN_MAX_PAGES=12
RUN_MAX_DEPTH=2
RUN_MAX_DOMAIN_PAGES=10
SUPERVISOR_MAX_ITERATIONS=3
SUPERVISOR_MAX_QUERIES=8
RUN_CREDIT_BUDGET=0
