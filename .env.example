# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Start the API from the REPO ROOT so this file is found:
#   set PYTHONPATH=backend && python -m uvicorn app.main:app --port 8000

# --- persistence (local-dev JSON files when absent) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# --- discovery ---
TAVILY_API_KEY=

# --- LLM chain: opencode (primary) -> groq -> gemini (fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- opencode primary generator (local server) ---
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
OPENCODE_TIMEOUT_S=240
# Pinned reader: free Zen model (verified VALID_JSON extraction envelopes).
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free
# Strict reader mode: opencode is THE reader, cloud fallbacks never fire.
OPENCODE_STRICT=false

# --- judge (Jev via OpenRouter) ---
TYPESAFE_API_KEY=

# --- optional fallbacks ---
JINA_API_KEY=
FEATURE_JINA=false

# --- budgets / caps (0 = unlimited where noted) ---
RUN_MAX_PAGES=12
RUN_MAX_DEPTH=2
RUN_MAX_DOMAIN_PAGES=10
SUPERVISOR_MAX_ITERATIONS=3
SUPERVISOR_MAX_QUERIES=8
RUN_CREDIT_BUDGET=0
