# Line endings are the repository's, not the checkout's.
#
# `core.autocrlf` was on and there was no attributes file, so every file
# edited on Windows showed as modified while `git diff` was empty. Text is
# stored as LF; the working tree gets LF too.
* text=auto eol=lf

# Windows launchers are read by cmd.exe, which needs CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.mp4 binary
*.webp binary
